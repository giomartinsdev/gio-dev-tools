{
  "cniVersion": "0.4.0",
  "name": "openfaas-cni-bridge",
  "plugins": [
    {
      "type": "bridge",
      "bridge": "persistence",
      "isGateway": false,
      "isDefaultGateway": false,
      "ipMasq": true,
      "hairpinMode": true,
      "ipam": {
        "type": "host-local",
        "ranges": [
          [
            {
              "subnet": "172.20.0.0/24",
              "rangeStart": "172.20.0.130",
              "rangeEnd": "172.20.0.254",
              "gateway": "172.20.0.1"
            }
          ]
        ],
        "routes": [{ "dst": "0.0.0.0/0", "gw": "172.20.0.1" }]
      }
    },
    { "type": "firewall" },
    { "type": "portmap", "capabilities": { "portMappings": true } }
  ]
}
